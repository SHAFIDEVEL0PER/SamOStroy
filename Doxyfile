# Основные настройки проекта
PROJECT_NAME           = "SamOStroy"
PROJECT_BRIEF          = "Документация для веб-приложения SamOStroy. Проектирование и строительство домов."
OUTPUT_DIRECTORY       = ./docs
CREATE_SUBDIRS         = NO

# Язык и кодировка
OUTPUT_LANGUAGE        = Russian
DOXYFILE_ENCODING      = UTF-8

# Настройки входных файлов
INPUT                  = html/ css/ js/ README.md  # Добавляем README.md для главной страницы
FILE_PATTERNS          = *.js *.html *.css
RECURSIVE              = YES
EXCLUDE                = */temp/* */old_versions/*

# Для HTML-файлов
HTML_FILE_EXTENSION    = .html

# Настройки главной страницы
USE_MDFILE_AS_MAINPAGE = README.md  # Использовать README.md как основу для index.html

# Для JavaScript (JSDoc-стиль)
JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_JAVADOC = YES

# Для CSS (минимальная поддержка)
EXTENSION_MAPPING      = .css=CSS

# Настройки вывода HTML
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE_HUE    = 220
HTML_EXTRA_STYLESHEET = css/custom.css  # Добавляем кастомные стили
HTML_EXTRA_FILES       = images/logo.png  # Добавляем дополнительные файлы

# Включение большего количества информации
EXTRACT_ALL            = YES  # Извлекать документацию для всех элементов
EXTRACT_PRIVATE        = YES  # Включать приватные члены
EXTRACT_STATIC         = YES  # Включать статические члены